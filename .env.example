# Web3Forms — contact form email delivery
# 1. Go to https://web3forms.com and create a form with uroooj056@gmail.com
# 2. Copy your access key
# 3. Add to Vercel → Settings → Environment Variables:
#    Key:   NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY
#    Value: your_access_key_here
# 4. Redeploy (required — env vars are baked in at build time)

NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_access_key_here
